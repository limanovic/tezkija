# Supabase project used for accounts and progress sync. Leave both unset and
# the app runs without accounts, everything stays on the device.
# Project settings → API in the Supabase dashboard.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Web Push (web build only). Public half of the VAPID pair; the private half
# is a secret of the send-reminders Edge Function. Generate once:
#   npx web-push generate-vapid-keys
EXPO_PUBLIC_VAPID_PUBLIC_KEY=B...
